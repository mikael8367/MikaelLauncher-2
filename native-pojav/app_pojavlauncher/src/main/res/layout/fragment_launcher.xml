<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mikael_background"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp">

    <TextView
        android:id="@+id/mikael_brand"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="MIKAEL / NEXUS"
        android:textColor="@color/mikael_lime"
        android:textSize="21sp"
        android:textStyle="bold"
        android:fontFamily="@font/noto_sans_bold"
        android:letterSpacing="0.08"
        app:layout_constraintEnd_toStartOf="@id/mikael_account"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/mikael_account"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● ONLINE"
        android:textColor="@color/mikael_accent"
        android:textSize="13sp"
        android:fontFamily="@font/noto_sans_bold"
        app:layout_constraintBottom_toBottomOf="@id/mikael_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mikael_brand" />

    <TextView
        android:id="@+id/mikael_welcome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="CENTRAL DE CONTROLE\nSeu Minecraft Java, no seu ritmo."
        android:textColor="@color/secondary_text"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mikael_brand" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mikael_active_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/mikael_active_card"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mikael_welcome">

        <TextView
            android:id="@+id/mikael_active_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NÚCLEO ATIVO"
            android:textColor="@color/mikael_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mikael_performance_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/mikael_status_pill"
            android:text="● TURBO READY"
            android:textColor="#6BFFB0"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/mikael_active_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SURVIVAL / PRIME"
            android:textColor="@color/primary_text"
            android:textSize="21sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mikael_active_label" />

        <TextView
            android:id="@+id/mikael_active_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="FORGE   •   JAVA 8   •   TURBO READY"
            android:textColor="@color/secondary_text"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mikael_active_name" />

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:textColor="@color/primary_text"
            app:layout_constraintEnd_toStartOf="@id/edit_profile_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mikael_active_meta" />

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_edit_profile"
            app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/mikael_play_button"
        android:text="INICIAR SESSÃO"
        android:textColor="#11120D"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mikael_active_card" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/play_button">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="MÓDULOS DO NEXUS"
                android:textColor="@color/secondary_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/import_resourcepack_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="Importar textura (.zip / .mcpack)"
                android:textColor="@color/mikael_lime" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/import_shaderpack_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@drawable/ic_setting_video"
                android:text="Importar shader (.zip / .mcshader)"
                android:textColor="@color/mikael_accent" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@drawable/ic_menu_news"
                android:text="Catálogo de versões"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/discord_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@drawable/ic_discord"
                android:text="Hub da comunidade"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@drawable/ic_menu_custom_controls"
                android:text="Controles / gamepad"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@drawable/ic_menu_install_jar"
                android:text="Mods / modpacks"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@android:drawable/ic_menu_share"
                android:text="Telemetria / diagnóstico"
                android:textColor="@color/primary_text" />

            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/LauncherMenuButton.Universal"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="10dp"
                android:background="@drawable/mikael_menu_button"
                android:drawableStart="@drawable/ic_folder"
                android:text="Arquivos / mundos"
                android:textColor="@color/primary_text" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
