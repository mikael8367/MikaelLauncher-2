<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@color/background_app">
    <TextView android:id="@+id/mod_manager_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Mods da instalação" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/mikael_lime"/>
    <TextView android:id="@+id/mod_manager_path" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="middle" android:maxLines="1" android:textColor="@color/secondary_text" android:paddingTop="4dp"/>
    <EditText android:id="@+id/mod_manager_search" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Filtrar mods instalados" android:singleLine="true" android:inputType="text"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="8dp">
        <Button android:id="@+id/mod_manager_curseforge" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="CurseForge" android:textAllCaps="false"/>
        <Button android:id="@+id/mod_manager_import" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Importar .jar / .zip" android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/mod_manager_backup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Backup" android:textAllCaps="false"/>
        <Button android:id="@+id/mod_manager_restore" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Restaurar" android:textAllCaps="false"/>
        <Button android:id="@+id/mod_manager_refresh" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Atualizar" android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/mod_manager_enable_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Ativar todos" android:textAllCaps="false"/>
        <Button android:id="@+id/mod_manager_disable_all" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Desativar todos" android:textAllCaps="false"/>
        <Button android:id="@+id/mod_manager_report" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Relatório" android:textAllCaps="false"/>
    </LinearLayout>
    <TextView android:id="@+id/mod_manager_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="8dp" android:paddingBottom="8dp" android:textColor="@color/secondary_text"/>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/mod_manager_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </ScrollView>
</LinearLayout>
